{
  "name": "ci-cd-pipeline-e2e-tests",
  "version": "1.0.0",
  "description": "E2E and API tests for CI/CD pipeline",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test api-tests.spec.ts",
    "test:e2e": "playwright test e2e-tests.spec.ts",
    "install:ci": "npx playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "playwright": "^1.40.0"
  }
}
