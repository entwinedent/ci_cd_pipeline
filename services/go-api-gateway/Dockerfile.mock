# Mock Data Store Server
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy mock server
COPY test/mock-server.go .

# Build mock server
RUN CGO_ENABLED=0 GOOS=linux go build -o mock-server mock-server.go

# Final stage
FROM alpine:latest

# Copy binary
COPY --from=builder /app/mock-server /mock-server

# Expose port
EXPOSE 50051

# Run mock server
ENTRYPOINT ["/mock-server"]
